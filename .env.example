POSTGRES_DB=culinary_blog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=change_this_postgres_password

MINIO_ROOT_USER=culinary_minio
MINIO_ROOT_PASSWORD=change_this_minio_password_123

# Local development only. Replace with a random secret of at least 32 characters.
JWT_SECRET=DockerDevJwtSecretKey_NotForProduction_Min256Bits!

# Local development only. Replace with a generated secret; never use this example value in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=DockerDevJwtSecretKey_NotForProduction_Min256Bits!

# Browser-facing frontend URL used by Auth.js redirects and password-reset links.
# For web deployment, replace localhost with the externally reachable HTTPS origin.
FRONTEND_BASE_URL=http://localhost:3000

# This value is embedded into the frontend image at build time.
# For non-local Docker deployments, set this to the API URL reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/culinary-blog
# Public Google OAuth 2.0 Web Client ID for local development (http://localhost:3000).
# Both frontend (GIS button) and backend (Google ID Token audience check) read this value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=295364535185-qgfc1nr0184opvmk03rpit37ce34g040.apps.googleusercontent.com

# --- Optional Admin seed ---
# Set to true only when supplying a deployment-specific account and a strong password.
# Do not use a shared/default Admin credential on a web deployment.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- SMTP (Docker Compose) ---
# By default, Compose routes emails to the bundled MailHog container (mailhog:1025, UI at http://127.0.0.1:8025).
# To send real transactional emails (e.g., Forgot Password via Brevo), uncomment and fill in your local .env:
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=587
#SMTP_USE_SSL=false
#SMTP_USERNAME=c0e4eb001@smtp-brevo.com
#SMTP_PASSWORD=your_smtp_password_here
#SMTP_FROM_ADDRESS=phunam2312695@gmail.com
#SMTP_FROM_NAME=Culinary Blog

# --- SMTP (Production) ---
# Production requires a real SMTP server. The API refuses to start if these are missing,
# if Smtp__Host is "mailhog", or if Smtp__FromAddress ends with ".local".
# Smtp__Host=<smtp-host-of-provider>
# Smtp__Port=587
# Smtp__UseSsl=false   (port 587 = STARTTLS; set true ONLY for implicit TLS on port 465)
# Smtp__Username=<username>
# Smtp__Password=<password>   (set via secret manager / environment variable; never commit a real value)
# Smtp__FromAddress=no-reply@<real-domain>

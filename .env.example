POSTGRES_DB=culinary_blog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=change_this_postgres_password

MINIO_ROOT_USER=culinary_minio
MINIO_ROOT_PASSWORD=change_this_minio_password_123

# Local development only. Replace with a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# This value is embedded into the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- SMTP (Production) ---
# Production requires a real SMTP server. The API refuses to start if these are missing,
# if Smtp__Host is "mailhog", or if Smtp__FromAddress ends with ".local".
# Smtp__Host=<smtp-host-of-provider>
# Smtp__Port=587
# Smtp__UseSsl=false   (port 587 = STARTTLS; set true ONLY for implicit TLS on port 465)
# Smtp__Username=<username>
# Smtp__Password=<password>   (set via secret manager / environment variable; never commit a real value)
# Smtp__FromAddress=no-reply@<real-domain>
